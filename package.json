{
  "name": "let-it-blossom",
  "version": "1.0.1",
  "description": "🌸 Let your website bloom instantly. Realistic floating cherry blossom petals with 3D flutter, wind dynamics, and mouse interaction. Zero dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": "./dist/cherryblossom.global.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austinhttps/let-it-blossom.git"
  },
  "keywords": [
    "cherry-blossom",
    "sakura",
    "petals",
    "canvas",
    "animation",
    "effects",
    "particles",
    "let-it-go",
    "spring"
  ],
  "author": "Austin M",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/austinhttps/let-it-blossom/issues"
  },
  "homepage": "https://github.com/austinhttps/let-it-blossom#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
